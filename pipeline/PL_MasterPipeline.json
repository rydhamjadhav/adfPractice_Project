{
	"name": "PL_MasterPipeline",
	"properties": {
		"activities": [
			{
				"name": "LoadDimension",
				"description": "This pipeline is for loading the dimension",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_CopyDimension",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "Load_CleansedOrders",
				"description": "for loading the orders(fact table)",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "LoadDimension",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_LoadOrders",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "LoadEnrichData",
				"description": "to insert the pending blank data itno sql",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "Load_CleansedOrders",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "DF_EnrichOrders",
						"type": "DataFlowReference"
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "NotifyWhenSuccess",
				"description": "notif of success ",
				"type": "WebHook",
				"dependsOn": [
					{
						"activity": "LoadEnrichData",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": "https://webhook.site/91b1077f-1c27-4f41-96c2-69b21eff3bed",
					"method": "POST",
					"body": {
						"value": "{\n    \"pipeline\": \"@{pipeline().Pipeline}\",\n    \"status\": \"Success\",\n    \"runId\" : \"@{pipeline().RunId}\",\n    \"completedAt\" : \"@{utcnow()}\",\n    \"message\" : \"ShopEasy ADF pipeline completed successfully\"\n    }",
						"type": "Expression"
					},
					"timeout": "00:10:00"
				}
			}
		],
		"parameters": {
			"Master": {
				"type": "string",
				"defaultValue": "Full"
			}
		},
		"annotations": []
	}
}