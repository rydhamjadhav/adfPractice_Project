{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-shopezdata"
		},
		"ls_Blobstorage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_Blobstorage'"
		},
		"ls_SQLDatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_SQLDatabase'"
		},
		"ls_SQLDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlshopez.database.windows.net"
		},
		"ls_SQLDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dbshpez"
		},
		"ls_SQLDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "central"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_MasterPipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "LoadDimension",
						"description": "This pipeline is for loading the dimension",
						"type": "ExecutePipeline",
						"dependsOn": [],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "pl_CopyDimension",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {}
						}
					},
					{
						"name": "Load_CleansedOrders",
						"description": "for loading the orders(fact table)",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "LoadDimension",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "pl_LoadOrders",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {}
						}
					},
					{
						"name": "LoadEnrichData",
						"description": "to insert the pending blank data itno sql",
						"type": "ExecuteDataFlow",
						"dependsOn": [
							{
								"activity": "Load_CleansedOrders",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.00:30:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "DF_EnrichOrders",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"factOrders": {},
									"Customer": {},
									"Product": {},
									"LoadEnrichOrders": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					},
					{
						"name": "NotifyWhenSuccess",
						"description": "notif of success ",
						"type": "WebHook",
						"dependsOn": [
							{
								"activity": "LoadEnrichData",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"url": "https://webhook.site/91b1077f-1c27-4f41-96c2-69b21eff3bed",
							"method": "POST",
							"headers": {},
							"body": {
								"value": "{\n    \"pipeline\": \"@{pipeline().Pipeline}\",\n    \"status\": \"Success\",\n    \"runId\" : \"@{pipeline().RunId}\",\n    \"completedAt\" : \"@{utcnow()}\",\n    \"message\" : \"ShopEasy ADF pipeline completed successfully\"\n    }",
								"type": "Expression"
							},
							"timeout": "00:10:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"Master": {
						"type": "string",
						"defaultValue": "Full"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/pl_CopyDimension')]",
				"[concat(variables('factoryId'), '/pipelines/pl_LoadOrders')]",
				"[concat(variables('factoryId'), '/dataflows/DF_EnrichOrders')]"
			]
		},
